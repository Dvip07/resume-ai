# frontend/.env — committed defaults for local development.
#
# Vite only exposes variables prefixed with VITE_ to client code, and these
# values are inlined into the production bundle at build time. Keep secrets out
# of this file: anything here is public.
#
# Load order (later wins): .env -> .env.[mode] -> .env.local -> .env.[mode].local
# Override locally in .env.local (gitignored) instead of editing this file.

# Base URL of the Laravel API, including the /api prefix.
# Matches `php artisan serve`'s default host/port in backend/.
VITE_API_BASE_URL=http://localhost:8001/api
