APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Scheduled discovery fan-out (Requirements 3.1, 11.1). Needs `schedule:run`
# on a cron, or a `schedule:work` process — see docs/deployment/queue-workers.md.
# Cron expression; the command only queues one job per user, so hourly is cheap.
PIPELINE_DISCOVERY_ENABLED=true
PIPELINE_DISCOVERY_CRON="0 * * * *"
PIPELINE_DISCOVERY_TIMEZONE=UTC

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- S3 artifact storage (Requirement 8.1)
# Credentials for the IAM user/role that owns the artifact bucket. Leave empty
# here and in committed .env files — never commit real secrets.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Region the bucket lives in, e.g. us-east-1.
AWS_DEFAULT_REGION=us-east-1
# Bucket holding original resumes, tailored resumes and cover letters.
AWS_BUCKET=
# Optional: custom base URL / S3-compatible endpoint (MinIO, LocalStack, R2).
AWS_URL=
AWS_ENDPOINT=
# true when using an S3-compatible endpoint that needs path-style addressing.
AWS_USE_PATH_STYLE_ENDPOINT=false

# Disk used for resume/artifact storage (config/filesystems.php
# `resume_disk`). Defaults to 's3'. For local development without AWS
# credentials set this to `public` so uploads land on the local disk and the
# rest of the flow (text extraction, parsing job) still works.
RESUME_STORAGE_DISK=s3

# --- OpenRouter tiered model routing (Requirement 4)
# API key for every LLM call in the pipeline. Leave empty here and in any
# committed .env — the real key belongs only in the untracked local/deployed
# .env or the platform's secret store (Requirement 4.7).
OPENROUTER_API_KEY=
# Everything else in config/services.php `openrouter` has a working default
# (model tiers, salary/complexity thresholds, timeouts). Override only when
# retuning cost/quality, e.g.:
# OPENROUTER_DEFAULT_TIER=cheap
# OPENROUTER_SALARY_THRESHOLD_STANDARD=90000
# OPENROUTER_SALARY_THRESHOLD_PREMIUM=150000
# OPENROUTER_TIMEOUT=120

# --- Adzuna job source (Requirement 3.1)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Adzuna is per-country: this selects the index AND determines the currency of
# every salary in the response (gb, us, ca, au, de, fr, in, ...). A country
# with no entry in config/services.php `adzuna.currencies` means salaries are
# dropped rather than mislabelled.
ADZUNA_COUNTRY=ca
# Optional tuning; defaults live in config/services.php.
# ADZUNA_RESULTS_PER_PAGE=5
# ADZUNA_MAX_DAYS_OLD=30
# JOB_SOURCE_ADZUNA_ENABLED=true
# Daily fetch budget per user (Requirement 3.6): once spent, discovery skips
# this source for the rest of the day instead of calling it. 0 = unlimited.
# ADZUNA_DAILY_LIMIT=25

# --- JSearch job source, via RapidAPI (Requirement 3.1)
# The second aggregator (re-indexes LinkedIn/Indeed/Glassdoor postings),
# replacing the dead linkedin-job-api integration. Off by default: it needs a
# paid RapidAPI subscription, and open decision #2 in design.md (which second
# aggregator) is unconfirmed. Set the key AND the flag to bring it into the
# discovery fan-out. Named JSEARCH_RAPIDAPI_KEY but falls back to the older
# RAPIDAPI_KEY if that is already set.
JSEARCH_RAPIDAPI_KEY=
JOB_SOURCE_JSEARCH_ENABLED=false
# Optional tuning; defaults live in config/services.php.
# Recency filter: all | today | 3days | week | month
# JSEARCH_DATE_POSTED=week
# Result pages per call — each page is ~10 postings and one request against
# your plan's quota.
# JSEARCH_NUM_PAGES=1
# Optional 2-letter country scope; empty lets the query's free-text location
# decide.
# JSEARCH_COUNTRY=
# JSEARCH_TIMEOUT=15
# Daily fetch budget per user (Requirement 3.6). 0 = unlimited.
# JSEARCH_DAILY_LIMIT=10

# --- Public ATS job boards: Greenhouse and Lever (Requirement 3.1)
# The companies' own public board feeds: no API key, no quota. A board belongs
# to one company, so these sources poll nothing until you list the companies you
# want to target. Both are enabled by default and inert while these are empty.
#
# Comma-separated slugs, each optionally followed by :Display Name. The slug is
# the path segment in the board URL — boards.greenhouse.io/acme or
# jobs.lever.co/acme is `acme`. Set a display name when the slug isn't the
# company's name; it's stored on the job listing and shown to the user.
GREENHOUSE_COMPANIES=
LEVER_COMPANIES=
# Optional tuning; defaults live in config/services.php.
# Board APIs take no search parameters (a request returns every open role), so
# the query is applied client-side. MATCH_TITLES keeps only postings whose title
# contains all the words of one of your target roles — turning it off means
# every open role on every configured board gets scored, at cost.
# GREENHOUSE_MATCH_TITLES=true
# LEVER_MATCH_TITLES=true
# Off because board location strings are free text ("SF Bay Area (Hybrid)"), so
# matching a typed location against them drops real matches. A remote-only
# search is still honoured either way.
# GREENHOUSE_FILTER_BY_LOCATION=false
# LEVER_FILTER_BY_LOCATION=false
# JOB_SOURCE_GREENHOUSE_ENABLED=true
# JOB_SOURCE_LEVER_ENABLED=true
# GREENHOUSE_TIMEOUT=15
# LEVER_TIMEOUT=15
# Unlimited (0) by default: no key, no quota, no per-call cost. Set a number
# only if a board starts throttling you.
# GREENHOUSE_DAILY_LIMIT=0
# LEVER_DAILY_LIMIT=0

# --- LLM web-search job source (Requirement 3.1)
# Finds roles the indexed sources never see (a company's own careers page, a
# board with no configured slug) by asking a web-search-augmented model. No key
# of its own: it runs through ModelRouterService, so OPENROUTER_API_KEY covers
# it. Enabled by default; unlike the other sources it costs money per discovery
# run (web search is billed per request on top of tokens), so turn it off when a
# run needs to be cheap.
# JOB_SOURCE_LLM_SEARCH_ENABLED=true
# Optional tuning; defaults live in config/services.php.
# Which openrouter tier holds the search-capable models. Pinned as a capability
# requirement, not a cost choice — a model without live web access answers from
# training data, which looks like success and isn't.
# LLM_JOB_SEARCH_TIER=web_search
# Shows up in model_usage_logs.task_type, so discovery spend stays separable.
# LLM_JOB_SEARCH_TASK_TYPE=job_search
# Postings asked for per call. Higher mostly buys filler.
# LLM_JOB_SEARCH_MAX_RESULTS=15
# LLM_JOB_SEARCH_MAX_POSTED_AGE_DAYS=30
# Set false to ignore model-reported dates entirely; leads then carry no posted
# date, which the pipeline already handles as "unknown".
# LLM_JOB_SEARCH_TRUST_DATES=true
# Daily fetch budget per user (Requirement 3.6). Tightest of all the sources,
# since this is the only one billed per request. 0 = unlimited.
# LLM_JOB_SEARCH_DAILY_LIMIT=4

VITE_APP_NAME="${APP_NAME}"

# Production frontend origin, placeholder until the React app is deployed.
# Used by config/cors.php to allow-list cross-origin API requests.
FRONTEND_URL=http://localhost:5173

# --- API auth cookie (open decision #6: httpOnly cookie holds the Sanctum token)
# Local dev (Vite on localhost:5173 -> API on localhost:8000) is same-site, so
# Lax over plain http works. In production, where the frontend is on a
# different site, set AUTH_COOKIE_SAME_SITE=none and AUTH_COOKIE_SECURE=true
# (browsers reject SameSite=None without Secure).
AUTH_COOKIE_TTL=20160
AUTH_COOKIE_PATH=/
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
# CSRF mitigation: only honour the auth cookie when the request also sends
# X-Requested-With: XMLHttpRequest. Leave enabled.
AUTH_COOKIE_REQUIRE_XRW=true

# --- Browser-automation worker (Requirement 3.4b, task 9.2)
# The Node/Playwright sidecar in `automation-worker/` at the repo root. JD
# enrichment tries a plain HTTP fetch first and only asks the worker to render a
# posting when that yields nothing usable (a client-rendered page). Later it also
# runs the ApplyAdapter form automation (task 15).
#
# Disabled by default: with this false the backend never calls out, enrichment
# reports `no_content` and the posting is retried later — so local dev and CI
# need no browser running. Turn it on once the worker is up
# (`cd automation-worker && npm install && npm start`).
AUTOMATION_WORKER_ENABLED=false
AUTOMATION_WORKER_BASE_URL=http://127.0.0.1:8081
# Shared secret, sent as `X-Automation-Token`; must match the worker's own
# AUTOMATION_WORKER_TOKEN. The worker renders whatever URL it is handed, so an
# unauthenticated one reachable beyond loopback is an SSRF proxy. Generate with
# `openssl rand -hex 32`.
AUTOMATION_WORKER_TOKEN=
# Seconds. Kept above the worker's own navigation timeout (30s) so the worker is
# the side that gives up first and can say why. The connect timeout is short
# because a worker that isn't running should fail immediately.
AUTOMATION_WORKER_TIMEOUT=45
AUTOMATION_WORKER_CONNECT_TIMEOUT=5
# Optional render tuning; unset means the worker's own defaults apply.
# AUTOMATION_WORKER_WAIT_UNTIL=domcontentloaded
# AUTOMATION_WORKER_SETTLE_MS=1500
# Pass the selector the plain fetch was hoping for as a render hint. Off by
# default: waiting for a settle period is more robust across sites whose
# container name isn't in config/enrichment.php at all.
AUTOMATION_WORKER_WAIT_FOR_SELECTOR=false
# Apply automation (POST /apply) shares the address and token above; only the
# budget differs, since a multi-page form outlives a single render.
AUTOMATION_WORKER_APPLY_TIMEOUT=180
# AUTOMATION_WORKER_APPLY_PATH=/apply
# Worker-side budget; keep it below AUTOMATION_WORKER_APPLY_TIMEOUT so the
# worker is the side that gives up first and can say why.
# AUTOMATION_WORKER_APPLY_TIMEOUT_MS=120000
# Unset keeps the worker's own desktop string: an apply run is completing a
# form, not identifying a crawler.
# AUTOMATION_WORKER_APPLY_USER_AGENT=
