# Automation worker (Node/Playwright) — copy to .env and adjust.
#
# The Laravel side has its own matching block; see the `automation_worker`
# section of backend/config/services.php and the AUTOMATION_WORKER_* keys in
# backend/.env.example. Both sides must agree on the port and the token.

# Bind address. Loopback by default: this service renders arbitrary URLs in a
# real browser, so it must not be reachable from outside. In Docker, set
# 0.0.0.0 and rely on the compose network not publishing the port — and set a
# token, since the worker refuses to start on a non-loopback bind without one.
AUTOMATION_WORKER_HOST=127.0.0.1
AUTOMATION_WORKER_PORT=8081

# Shared secret sent by Laravel as `X-Automation-Token`. Generate with
# `openssl rand -hex 32`. Empty is tolerated on a loopback bind only.
AUTOMATION_WORKER_TOKEN=

# Per-render navigation budget, milliseconds. Keep Laravel's
# AUTOMATION_WORKER_TIMEOUT a few seconds above this so the worker is the side
# that gives up first and can report why.
AUTOMATION_WORKER_NAVIGATION_TIMEOUT_MS=30000

# Playwright load state: load | domcontentloaded | networkidle | commit.
# `networkidle` is a poor fit for career pages with analytics beacons.
AUTOMATION_WORKER_WAIT_UNTIL=domcontentloaded

# Quiet period after the load state, to let a client-rendered description paint.
AUTOMATION_WORKER_SETTLE_MS=1500

# Concurrent renders. Each is a browser context, so this is the memory knob.
AUTOMATION_WORKER_MAX_CONCURRENCY=2

AUTOMATION_WORKER_MAX_HTML_BYTES=5000000
AUTOMATION_WORKER_HEADLESS=true

# Skip images/fonts/media. Nothing downstream reads pixels.
AUTOMATION_WORKER_BLOCK_ASSETS=true

# Default UA when the caller sends none. Laravel sends its own
# (`enrichment.user_agent`), so this is mostly for manual curl testing.
AUTOMATION_WORKER_USER_AGENT=

# Allow rendering loopback/private addresses. Off by default; turn it on only to
# point the worker at a local fixture server during development.
AUTOMATION_WORKER_ALLOW_PRIVATE_HOSTS=false
