# frontend/.env.example — template for environment-specific overrides.
#
# Copy to .env.local (gitignored) for machine-specific values, or to
# .env.production / .env.staging for per-environment builds:
#
#   cp .env.example .env.local
#
# Only VITE_-prefixed variables reach client code, and they are inlined into
# the bundle at build time — never put secrets here.

# Base URL of the Laravel API, including the /api prefix. No trailing slash
# needed (the API client strips it).
#   local dev:    http://localhost:8000/api
#   Sail/Docker:  http://localhost/api
#   staging/prod: https://api.example.com/api
VITE_API_BASE_URL=http://localhost:8000/api
