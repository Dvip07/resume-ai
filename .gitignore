# backend/ — Laravel API (no Node tooling; the SPA lives in frontend/)
/backend/.phpunit.cache
/backend/public/storage
/backend/storage/*.key
/backend/vendor
backend/.env
backend/.phpunit.result.cache
.env.backup
.env.production

# frontend/ — standalone Vite app with its own dependency tree
/frontend/node_modules
/frontend/dist
# frontend/.env holds committed, non-secret defaults; local/per-environment
# overrides stay out of git.
/frontend/.env.local
/frontend/.env.*.local
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
/.fleet
/.idea
/.vscode
